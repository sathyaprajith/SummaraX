# Gemini API Keys (Multiple keys for load balancing)
# Get your API key from: https://aistudio.google.com/app/apikey
REACT_APP_GEMINI_API_KEY=your_primary_gemini_api_key_here
REACT_APP_GEMINI_API_KEY_2=your_backup_gemini_api_key_2_here
REACT_APP_GEMINI_API_KEY_3=your_backup_gemini_api_key_3_here
REACT_APP_GEMINI_API_KEY_4=your_backup_gemini_api_key_4_here

# Claude API Key (Optional - for advanced mind maps)
# Get your API key from: https://console.anthropic.com/
# Note: If not configured, will fallback to Gemini for mind maps
REACT_APP_CLAUDE_API_KEY=your_claude_api_key_here
